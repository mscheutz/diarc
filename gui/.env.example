# Local Development Environment
# Copy this file to .env.development (which is gitignored)
# This file is loaded automatically by Create React App when running `npm start`

# Enable dev mode - bypasses authentication
REACT_APP_DEV_MODE=true

# Point to local mock DIARC backend
# The WebSocket URL will be constructed as ws://localhost:8000/ws
REACT_APP_SERVER_ADDR=localhost

# Site ID for local development (optional, can be empty for local dev)
# REACT_APP_SITE_ID=local
