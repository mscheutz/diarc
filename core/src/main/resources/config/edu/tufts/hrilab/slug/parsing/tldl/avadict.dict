%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%% TEMPLATES %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

START-TEMPLATES

% delivering specific ditransitive verb
VERBDELT; {((C/PP)/REF)\AGENT; #a#x#y.?PH($a,$x,$y)}, {(C/PP)/REF; #x#y.?PH(?ADDRESSEE,$x,$y)}

%transitive verb
VERBT; {(C/REF)\AGENT; #a#y.?PH($a,$y)}, {(C/PP)\AGENT; #a#y.?PH($a,$y)}, {C/REF ; #x.?PH(?ADDRESSEE,$x)}, {C/PP ; #x.?PH(?ADDRESSEE,$x)}

%ditransitive verb
% Simplified template of this syntax worked: ((C/(REF | LREF | PP | NP | VP})/{AGENT})[\AGENT]
VERBDT; {((C/REF)/AGENT)\AGENT ; #a#x#y.?PH($a,$x,$y)},  {(C/REF)/AGENT ; #x#y.?PH(?ADDRESSEE,$x,$y)}, {((C/LREF)/AGENT)\AGENT ; #a#x#y.?PH($a,$x,$y)},  {(C/LREF)/AGENT ; #x#y.?PH(?ADDRESSEE,$x,$y)}, {((C/PP)/AGENT)\AGENT ; #a#x#y.?PH($a,$x,$y)},  {(C/PP)/AGENT ; #x#y.?PH(?ADDRESSEE,$x,$y)}, {((C/VP)/AGENT)\AGENT ; #a#x#y.?PH($a,$x,$y)},  {(C/VP)/AGENT ; #x#y.?PH(?ADDRESSEE,$x,$y)}, {((C/NP)/AGENT)\AGENT ; #a#x#y.?PH($a,$x,$y)},  {(C/NP)/AGENT ; #x#y.?PH(?ADDRESSEE,$x,$y)}
%VERBDTCOMPLEX; {((C/REF)/NP)\AGENT ; #a#x#y.?PH($a,$x,$y)},  {(C/REF)/NP ; #x#y.?PH(?ADDRESSEE,$x,$y)}, {((C/LREF)/NP)\AGENT ; #a#x#y.?PH($a,$x,$y)},  {(C/LREF)/NP ; #x#y.?PH(?ADDRESSEE,$x,$y)}, {((C/PP)/NP)\AGENT ; #a#x#y.?PH($a,$x,$y)},  {(C/PP)/NP ; #x#y.?PH(?ADDRESSEE,$x,$y)}, {((C/VP)/NP)\AGENT ; #a#x#y.?PH($a,$x,$y)},  {(C/VP)/NP ; #x#y.?PH(?ADDRESSEE,$x,$y)}, {((C/NP)/NP)\AGENT ; #a#x#y.?PH($a,$x,$y)},  {(C/NP)/NP ; #x#y.?PH(?ADDRESSEE,$x,$y)}

%VERBDTCOMPLEX;
% Simplified template of this syntax worked: (((C/(LREF | PP | NP | VP})/PP)/AGENT})[\AGENT]
VERBDTCOMPLEX; {(((C/PP)/PP)/AGENT)\AGENT; #a#x#y#z.?PH($a,$x,$y,$z)}, {((C/PP)/PP)/AGENT; #x#y#z.?PH(?ADDRESSEE,$x,$y,$z)}, {(((C/LREF)/PP)/AGENT)\AGENT; #a#x#y#z.?PH($a,$x,$y,$z)}, {((C/LREF)/PP)/AGENT; #x#y#z.?PH(?ADDRESSEE,$x,$y,$z)}, {(((C/NP)/PP)/AGENT)\AGENT; #a#x#y#z.?PH($a,$x,$y,$z)}, {((C/NP)/PP)/AGENT; #x#y#z.?PH(?ADDRESSEE,$x,$y,$z)}, {(((C/VP)/PP)/AGENT)\AGENT; #a#x#y#z.?PH($a,$x,$y,$z)}, {((C/VP)/PP)/AGENT; #x#y#z.?PH(?ADDRESSEE,$x,$y,$z)},

END-TEMPLATES

