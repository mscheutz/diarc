<root BTCPP_format="4" main_tree_to_execute="Inspect">
  <BehaviorTree ID="Inspect">
    <Sequence>
      <RetryUntilSuccessful num_attempts="3">
        <BatteryOK/>
      </RetryUntilSuccessful>
      <Timeout msec="5000">
        <Parallel success_count="-1" failure_count="1">
          <SubTree ID="Visit" destination="laboratory"/>
          <Repeat num_cycles="2">
            <InspectCamera/>
          </Repeat>
        </Parallel>
      </Timeout>
    </Sequence>
  </BehaviorTree>
  <BehaviorTree ID="Visit">
    <MoveBase goal="{destination}"/>
  </BehaviorTree>
</root>
