START-TEMPLATES

VERBI; {C\AGENT ; #x.?PH($x)}, {C ; ?PH(?ADDRESSEE)}

%% object and location both as references:
VERBT; {(C/REF)\AGENT ; #x#y.?PH($x,$y)}, {C/REF ; #x.?PH(?ADDRESSEE, $x)}
VERBTT; {(C/REF)/REF; #x#y.?PH(?ADDRESSEE,$x,$y)}, {((C/REF)/REF)\AGENT; #a#x#y.?PH($a,$x,$y)}
VERBTTT; {((C/REF)/REF)/REF; #x#y#z.?PH(?ADDRESSEE,$y,$x)}, {(((C/REF)/REF)/REF)\AGENT; #a#x#y#z.?PH($a,$y,$x)}

ADDRESSABLE; {AGENT ; ?PH}, {G/G, S/S,  C/C, Q/Q, G\G, S\S, C\C, Q\Q; #x.directAddress(?PH,$x)}

THING;{RN; ?PH:physobj ; VAR}, {DN; ?PH:property}
LOC;{RN; ?PH:location ; VAR}, {DN; ?PH:property}

%% object as property, location as reference:
%VERBT; {(C/DESC)\AGENT ; #x#y.?PH($x,$y)}, {C/DESC ; #x.?PH(?ADDRESSEE, $x)}
%VERBTR; {(C/REF)\AGENT ; #x#y.?PH($x,$y)}, {C/REF ; #x.?PH(?ADDRESSEE, $x)}
%VERBTT; {(C/REF)/DESC; #x#y.?PH(?ADDRESSEE,$x,$y)}, {((C/REF)/DESC)\AGENT; #a#x#y.?PH($a,$x,$y)}

END-TEMPLATES

