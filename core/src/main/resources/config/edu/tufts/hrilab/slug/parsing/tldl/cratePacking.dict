%TODO: Restrict types for refs in certain cases
START-TEMPLATES
VERBI; {C\AGENT ; #x.?PH($x)}, {C ; ?PH(?ADDRESSEE)}

VERBT; {(C/REF)\AGENT ; #x#y.?PH($x,$y)}, {C/REF ; #x.?PH(?ADDRESSEE, $x)}
ADDRESSABLE; {AGENT ; ?PH} ,{G/G, S/S, C/C, Q/Q, G\G, S\S, C\C, Q\Q; #x.directAddress(?PH,$x)}

GOTO; {C/REF ; #x.goToPoseDirect(?ADDRESSEE,$x)} ,{(C/REF)\AGENT ; #agent#x.goToPoseDirect($agent,$x)}

END-TEMPLATES

go to; GOTO
move to; GOTO
location; REF/REF; #l.$l
pose; REF/REF; #l.$l
pick up the box; C ; pickUpItem(?ADDRESSEE)
put down the box; C ; putDownItem(?ADDRESSEE)

dodemo; C; doDemo(?ADDRESSEE)
gripper; C; gripper(?ADDRESSEE)
camera; C; camera(?ADDRESSEE)
test vision; C; testVision(?ADDRESSEE)

items; VAL\NUM; #x.amount($x)
個です; VAL\NUM; #x.amount($x)
all of them; VAL; amount(max)
as many as possible; VAL; amount(max)
the maximum ammount; VAL; amount(max)

yes; VAL; val(yes)
no; VAL; val(no)
はい; VAL; val(yes);
いいえ; VAL ; val(no);

millimeters; VAL\NUM; #x.sizeInMM($x)
mm; VAL\NUM; #x.sizeInMM($x)
mmです; VAL\NUM; #x.sizeInMM($x)

%configure; C; packingConfigurationStub(?ADDRESSEE)

start packing; VERBI; packItemsIntoCrates
begin packing; VERBI; packItemsIntoCrates
I would like to set the packing parameters; VERBI; configurePackingParameters

done; VAL; replaced(packingCrate)
the crate has been replaced; VAL; replaced(packingCrate)

suspend current task; VERBI ; suspendSystemGoalsBlocking
resume current task; VERBI ; resumeSystemGoals
resume; VERBI ; resumeSystemGoals
cancel current task; VERBI ; cancelSystemGoals

what did you ask me; VERBI; repeatLastQuestion

hi; G ; hi
hi there; G ; hi_there
hello; G ; hello

check holding; C; checkHolding(?ADDRESSEE)
open gripper; C; openGripper(?ADDRESSEE)
close gripper; C; closeGripper(?ADDRESSEE)