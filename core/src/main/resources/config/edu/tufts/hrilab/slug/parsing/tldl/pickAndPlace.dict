%TODO: Restrict types for refs in certain cases
START-TEMPLATES
VERBI; {C\AGENT ; #x.?PH($x)}, {C ; ?PH(?ADDRESSEE)}

VERBT; {(C/REF)\AGENT ; #x#y.?PH($x,$y)}, {C/REF ; #x.?PH(?ADDRESSEE, $x)}
ADDRESSABLE; {AGENT ; ?PH} ,{G/G, S/S, C/C, Q/Q, G\G, S\S, C\C, Q\Q; #x.directAddress(?PH,$x)}

GOTO; {C/REF ; #x.goToPose(?ADDRESSEE,$x)} ,{(C/REF)\AGENT ; #agent#x.goToPose($agent,$x)}

END-TEMPLATES

robot one; ADDRESSABLE; robotone:agent
robot two; ADDRESSABLE; robottwo:agent
robot to; ADDRESSABLE; robottwo:agent

a; REF/RN ; #x.$x ; INDEFINITE
the; REF/RN ; #x.$x ; DEFINITE
one; REF/RN ; #x.$x ; INDEFINITE

it; REF ; it:physobj ; INFOCUS

%%TODO: test these in the current domain
suspend current goal; VERBI ; suspendSystemGoals
resume previous goal; VERBI ; resumeSystemGoals
resume goal; VERBI ; resumeSystemGoals
resume; VERBI ; resumeSystemGoals
cancel current goal; VERBI ; cancelSystemGoals
remove goal from queue at position; C/LIT* ; #x.cancelPendingGoalByIndex(?ADDRESSEE,$x)
%now; C/C; #x.urgentPriority(?ADDRESSEE,$x)
%right now; C\C; #x.urgentPriority(?ADDRESSEE,$x)

what is your current goal; VERBI; describeCurrentGoal
what are your pending goals; VERBI; describePendingGoals
cancel pending goals; VERBI; cancelAllPendingGoals
cancel all active goals; VERBI; cancelAllActiveGoals
cancel all goals; VERBI; cancelAllCurrentGoals

%%%%%%%%% Actions %%%%%%%%%

%% goToPose %%
go to; GOTO
move to; GOTO
move your gripper to; GOTO
location; REF/REF; #l.$l
pose; REF/REF; #l.$l

%% openGripper %%
open gripper; VERBI; openGripper
open the gripper; VERBI; openGripper
open your gripper; VERBI; openGripper
open grippers; VERBI; openGripper
open the grippers; VERBI; openGripper
open your grippers; VERBI; openGripper

%% closeGripper %%
close gripper; VERBI; closeGripper
close the gripper; VERBI; closeGripper
close your gripper; VERBI; closeGripper
close grippers; VERBI; closeGripper
close the grippers; VERBI; closeGripper
close your grippers; VERBI; closeGripper

%% detectBlock %%
look for; VERBT; detectBlock
search for; VERBT; detectBlock
find; VERBT; detectBlock
observe; VERBT; detectBlock
detect; VERBT; detectBlock
verify that you can see; VERBT; detectBlock

%% pick up no arg %%
pick up; C/BLOCKC ; #x.pickUp(?ADDRESSEE)
pickup; C/BLOCKC ; #x.pickUp(?ADDRESSEE)
grab; C/BLOCKC ; #x.pickUp(?ADDRESSEE)
get; C/BLOCKC ; #x.pickUp(?ADDRESSEE)
block; BLOCKC; block;
a; BLOCKC/BLOCKC ; #x.$x
the; BLOCKC/BLOCKC ; #x.$x
one; BLOCKC/BLOCKC ; #x.$x

%% pick up one arg
pickup; VERBT; pickUp
pick up; VERBT; pickUp
grab; VERBT; pickUp
get; VERBT; pickUp

%% put down no arg %%
put down; C/BLOCKC; #x.putDown(?ADDRESSEE)
putdown; C/BLOCKC; #x.putDown(?ADDRESSEE)
put; (C/PUTDOWNSUFFIX)/BLOCKC; #x#y.putDown(?ADDRESSEE)
place; (C/PUTDOWNSUFFIX)/BLOCKC; #x#y.putDown(?ADDRESSEE)
put down; C/REF; #x.putDown(?ADDRESSEE,$x)
putdown; C/REF; #x.putDown(?ADDRESSEE,$x)
put; (C/PUTDOWNSUFFIX)/REF; #x#y.putDown(?ADDRESSEE,$x)
place; (C/PUTDOWNSUFFIX)/REF; #x#y.putDown(?ADDRESSEE,$x)
down; PUTDOWNSUFFIX; down

%% moveBlockTo three arg (block,from,to) %%
move; ((C/REF)/REF)/REF; #x#y#z.moveBlockTo(?ADDRESSEE,$x,$y,$z)
transport; ((C/REF)/REF)/REF; #x#y#z.moveBlockTo(?ADDRESSEE,$x,$y,$z)
relocate; ((C/REF)/REF)/REF; #x#y#z.moveBlockTo(?ADDRESSEE,$x,$y,$z)
get; ((C/REF)/REF)/REF; #x#y#z.moveBlockTo(?ADDRESSEE,$x,$y,$z)
move; (C/MOVEBLOCKSUFFIX)/REF; #x#y.moveBlockTo(?ADDRESSEE,$x,$y)
transport; (C/MOVEBLOCKSUFFIX)/REF; #x#y.moveBlockTo(?ADDRESSEE,$x,$y)
relocate; (C/MOVEBLOCKSUFFIX)/REF; #x#y.moveBlockTo(?ADDRESSEE,$x,$y)
between; (MOVEBLOCKSUFFIX/LOCREF)/REF; #x#y.$x,$y
from; REF/REF; #x.$x
to; REF/REF; #x.$x
and; LOCREF/REF; #x.$x

%% moveBlockTo two arg (block,to) %%
put down; (C/REF)/REF; #x#y.moveBlockTo(?ADDRESSEE,$x,$y)
putdown; (C/REF)/REF; #x#y.moveBlockTo(?ADDRESSEE,$x,$y)
put; (C/REF)/REF; #x#y.moveBlockTo(?ADDRESSEE,$x,$y)
place; (C/REF)/REF; #x#y.moveBlockTo(?ADDRESSEE,$x,$y)
place down; (C/REF)/REF; #x#y.moveBlockTo(?ADDRESSEE,$x,$y)
put; ((C/REF)/PUTDOWNSUFFIX)/REF; #x#y#z.moveBlockTo(?ADDRESSEE,$x,$z)
place; ((C/REF)/PUTDOWNSUFFIX)/REF; #x#y#z.moveBlockTo(?ADDRESSEE,$x,$z)
at; REF/REF; #x.$x

%% moveBlockTo one arg (to) %%
put down; (C/REF)/BLOCKC; #x#y.moveBlockTo(?ADDRESSEE,$y)
putdown; (C/REF)/BLOCKC; #x#y.moveBlockTo(?ADDRESSEE,$y)
put; (C/REF)/BLOCKC; #x#y.moveBlockTo(?ADDRESSEE,$y)
place; (C/REF)/BLOCKC; #x#y.moveBlockTo(?ADDRESSEE,$y)
place down; (C/REF)/BLOCKC; #x#y.moveBlockTo(?ADDRESSEE,$y)
put; ((C/REF)/PUTDOWNSUFFIX)/BLOCKC; #x#y#z.moveBlockTo(?ADDRESSEE,$z)
place; ((C/REF)/PUTDOWNSUFFIX)/BLOCKC; #x#y#z.moveBlockTo(?ADDRESSEE,$z)

%% resetDomain %%
reset domain; VERBI; resetDomain
clear domain; VERBI; resetDomain

%%%%%%%%% Goal Wrappers %%%%%%%%%
%TODO: Unsure if wrapper name is best for LLM, very close to moveBlockTo
get; (C/REF)/REF; #x#y.getBlockTo(?ADDRESSEE,$x,$y)
i want; (C/WANTBLOCKATREF)/REF; #x#y.getBlockTo(?ADDRESSEE,$x,$y)
at; WANTBLOCKATREF/REF; #x.$x
to be at; WANTBLOCKATREF/REF; #x.$x
make it so; (C/WANTBLOCKATREF2)/REF; #x#y.getBlockTo(?ADDRESSEE,$x,$y)
is at; WANTBLOCKATREF2/REF; #x.$x

%%%%%%%%% Belief Assertions %%%%%%%%%

%% at(X,Y) %%
is at; (S/REF)\REF; #x#y.and(not(at($x,Y)),at($x,$y))
moved to; (S/REF)\REF; #x#y.and(not(at($x,Y)),at($x,$y))
has moved to; (S/REF)\REF; #x#y.and(not(at($x,Y)),at($x,$y))
has moved from; ((S/REF)/REF)\REF; #x#y#z.and(not(at($x,Y)),at($x,$z))

%% not(at(X,Y)) %%
is not at; (S/REF)\REF; #x#y.not(at($x,$y))
is no longer at; (S/REF)\REF; #x#y.not(at($x,$y))
has moved from; (S/REF)\REF; #x#y.not(at($x,$y))
%is not at; (C/REF)\REF; #x#y.forgetThat(?ADDRESSEE,at($x,$y))
%is no longer at; (C/REF)\REF; #x#y.forgetThat(?ADDRESSEE,at($x,$y))
%has moved from; (C/REF)\REF; #x#y.forgetThat(?ADDRESSEE,at($x,$y))

%TODO: make sure this actually applies to domain
%% supervisor/admin permissions %%
eric;AGENT;eric
pete;AGENT;pete
is trusted; S\AGENT ; #a.trusted($a)
is not trusted; S\AGENT ; #a.not(trusted($a))
%define new speaker; S/LIT*; #s.name($s,$s)
add new supervisor; S/LIT*; #s.supervisor($s)
add new admin; S/LIT* ; #a.admin($a)
remove supervisor; S/LIT*; #s.not(supervisor($s))
remove admin; S/LIT* ; #a.not(admin($a))
is a supervisor; S\AGENT; #s.supervisor($s)
is not a supervisor; S\AGENT; #s.not(supervisor($s))
is an admin; S\AGENT ; #a.admin($a)
is not an admin; S\AGENT ; #a.not(admin($a))

%%%%%%%%% ITK %%%%%%%%%
%%Do we even want this since all actions require verifying the object location and/or will not take into account where it thinks a block is?
%where is; Q/REF ; #x.know(?ADDRESSEE,whereAt($x))
where is; VERBT ; describeBlockPose
%where; KNOWABLE/REF; #x.whereAt($x,X)
%where; KNOWABLEWHEREIS/REF; #x.whereAt($x)
%is; KNOWABLE\KNOWABLEWHEREIS; #x.$x

%TODO add entries for variations of these
what blocks are you aware of; VERBI; describeKnownBlocks
what blocks are at; VERBT; describeBlocksAt
how many blocks are at; VERBT; describeNumberOfBlocksAt
are any blocks at; Q/REF; #x.blocksAt($x)
is there a; (Q/REF)/REF; #x#y.at($x,$y)
what types of blocks can you detect; VERBI; describeBlockTypes

is; Q/KNOWABLE; #x.know(?ADDRESSEE,$x)
a supervisor; KNOWABLE\AGENT; #x.supervisor($x)
an admin; KNOWABLE\AGENT; #x.admin($x)

%TODO: issue somewhere with knowHow parse matching early when more args are present and overloaded entries exist which take in different numbers of args
do; Q/ C; #x.$x
you; AGENT; ?ADDRESSEE
know how; (C/INF)\AGENT ; #a#i.knowHow($a,$i)
know; (C/KNOWABLE)\AGENT ; #a#k.know($a,$k)
to; INF/C; #x.to($x)
see; (C/REF)\AGENT ; #x#y.see($x,$y)

%TODO: is there any nice way to have just 'location one' be a VAL which is the ref for location one?
% Doesn't seem like it, any workaround rule will try to match fully on 'location one' rather than just 'location' and ignore the less specific entry
location; VAL/REF; #l.pose($l);
%area; VAL/REF; #a.pose($a);
%pose; VAL/REF; #a.pose($a);
%it is at; VAL/REF; #a.pose($a);
%at; VAL/REF; #a.pose($a);
%%the block is at; VAL/REF; #a.pose($a);

%Same issue for blocks
%the; VAL/REF; #l.blockType($l);
block; VAL/REF; #l.blockType($l);

%TODO: ability to do this (and to do this for both block and pose questions)
nowhere; VAL; pose(none);
none; VAL; blockType(none);
%nevermind; VAL; pose(none);
nevermind; VAL; blockType(none);

yes; VAL; val(yes);
はい; VAL; val(yes);
no; VAL; val(no);
いいえ; VAL ; val(no);

%% LLM control %%
clear conversation history; VERBI; clearConversationHistory
toggle nlg; VERBI; toggleLLMNLG

%% Testing only %%
test nlg; C/LIT*; #x.testLLMNLGWithString(?ADDRESSEE,$x);