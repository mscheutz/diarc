%never mind; VAL; objectType(none);
no block; VAL; objectType(none);
no object; VAL; objectType(none);
nowhere; VAL; pose(none);
none; VAL; abort(question);
%nevermind; VAL; abort(question);
nevermind; VAL; abort(question);
never mind; VAL; abort(question);

yes; VAL; val(yes);
はい; VAL; val(yes);
no; VAL; val(no);
いいえ; VAL ; val(no);

