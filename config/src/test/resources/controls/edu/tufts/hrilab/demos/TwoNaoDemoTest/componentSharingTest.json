      "serviceArgs" : [ "404", "SUCCEEDED" ]
    } ]
  }, {
    "serviceCalls" : [ {
      "serviceName" : "sayText",
      "serviceArgs" : [ "REPLY(shafer,ravenna,ack(yes),\"yes\",{})", "true" ]
    } ]
  }, {
    "serviceCalls" : [ {
