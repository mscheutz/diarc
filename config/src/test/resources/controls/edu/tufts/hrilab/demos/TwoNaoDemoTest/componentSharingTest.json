    }, {
      "serviceName" : "sayText",
      "serviceArgs" : [ "REPLY(shafer,ravenna,ack(yes),\"yes\",{})", "true" ]
    }, {
      "serviceName" : "submitGoal",
      "serviceArgs" : [ "look(dempster,up)", "ACT", "NORMAL", "1", "ravenna", "436" ]
    }, {
