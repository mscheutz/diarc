#!/bin/bash

set -e

basePath=`pwd`
tradeLoggingPath=${basePath}/tradeLogging.config
tracsLoggingPath=${basePath}/logback.xml
tradePropertiesPath=${basePath}/trade.properties
main=edu.tufts.hrilab.config.tr.CratePacking

java -DtradeLogging.config.path=$tradeLoggingPath -Dlogback.configurationFile=$tracsLoggingPath -Dtrade.properties.path=$tradePropertiesPath -cp tracs.jar: edu.tufts.hrilab.diarc.DiarcConfiguration $main